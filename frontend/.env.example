NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth
AUTH_SECRET=change-me-in-production

# Google OAuth (SSO) — obtener en console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary — optimiza las imágenes en lugar de Vercel (ver
# src/lib/cloudinary-loader.ts). Sin esta variable los avatares caen a su URL
# de origen y el CSP los bloquea.
#
# Requiere tener habilitado "fetched URL" en la cuenta de Cloudinary, con los
# CDNs de Meta (scontent*.cdninstagram.com, *.fbcdn.net) en allowed sources.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
