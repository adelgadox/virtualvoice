SECRET_KEY=57....
DEBUG=true
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cloudinary — aloja los avatares de Instagram bajo la carpeta virtualvoice/.
# El backend los sube al conectar la cuenta (app/services/cloudinary_avatar.py)
# y guarda la URL resultante; el frontend no necesita credenciales porque la
# URL ya viene en la respuesta de la API.
# Sin estas variables el avatar conserva la URL del CDN de Meta, que el CSP
# bloquea — se ve la inicial de respaldo en su lugar.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET= 
